---
import IconPage from "@/components/icon-page.astro";
import { IconBrandDiscordFilled, IconBrandXFilled } from "@tabler/icons-react";
---

<footer class="mt-20 border-t border-border">
    <div class="py-10 flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
        <div class="flex flex-col gap-2">
            <IconPage />
            <p class="text-xs text-text-muted max-w-xs leading-relaxed">
                Your favorite source for anime and manga information.
            </p>
        </div>

        <div class="flex items-center gap-2">
            <a
                href="https://discord.com"
                target="_blank"
                rel="noopener"
                aria-label="Discord"
                class="p-2.5 rounded-xl text-text-muted hover:text-accent bg-surface border border-border hover:border-border-hover transition-all duration-300"
            >
                <IconBrandDiscordFilled size={14} />
            </a>

            <a
                href="https://twitter.com"
                target="_blank"
                rel="noopener"
                aria-label="Twitter / X"
                class="p-2.5 rounded-xl text-text-muted hover:text-accent bg-surface border border-border hover:border-border-hover transition-all duration-300"
            >
                <IconBrandXFilled size={14} />
            </a>
        </div>
    </div>

    <div class="pb-8 text-center space-y-1">
        <p class="text-[11px] text-text-muted">
            © {new Date().getFullYear()} AnimeWiki
        </p>
        <p class="text-[11px] text-text-muted">
            Built by
            <a
                class="text-accent font-medium hover:underline"
                referrerpolicy="no-referrer"
                rel="noopener noreferrer"
                href="http://github.com/larry-ceballos"
            >
                Larry-Ceballos
            </a>
        </p>
    </div>
</footer>