---
import { IconSearch } from "@tabler/icons-react";
import IconPage from "@/components/icon-page.astro";

const path = Astro.url.pathname;
const enlaces = [
    { href: "/", texto: "Home" },
    { href: "/watchlist", texto: "Watchlist" },
    { href: "/seasons", texto: "Seasons" },
    { href: "/news", texto: "News" },
];
---

<header class="w-full sticky top-0 z-50 glass">
    <div class="max-w-6xl mx-auto px-4 flex items-center gap-6 py-4">
        <IconPage />

        <nav class="hidden md:flex items-center gap-1 ml-2">
            {
                enlaces.map((e) => (
                    <a
                        href={e.href}
                        class:list={[
                            "relative px-3 py-2 text-sm font-medium rounded-lg transition-all duration-300",
                            {
                                "text-accent bg-accent/8": path === e.href,
                            },
                            {
                                "text-text-secondary hover:text-text-primary hover:bg-white/4":
                                    path !== e.href,
                            },
                        ]}
                    >
                        {e.texto}
                    </a>
                ))
            }
        </nav>

        <div class="flex-1"></div>

        <form
            class="hidden sm:flex items-center gap-2 bg-white/4 rounded-xl overflow-hidden border border-border hover:border-border-hover transition-colors duration-300 focus-within:border-accent/30 focus-within:bg-white/6"
        >
            <input
                aria-label="Search"
                placeholder="Search anime or manga..."
                class="text-sm w-56 focus:outline-none px-4 py-2.5 bg-transparent text-text-primary placeholder:text-text-muted"
            />
            <button
                class="px-3 py-2.5 text-text-muted hover:text-accent transition-colors cursor-pointer"
            >
                <IconSearch size={18} />
            </button>
        </form>
    </div>
</header>
