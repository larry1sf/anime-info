---
import IconPage from "@/components/icon-page.astro";
import SearchInput from "@/components/search-input";
import ThemeToggle from "@/components/theme-toggle";

const path = Astro.url.pathname;
const enlaces = [
    { href: "/", texto: "Home" },
    { href: "/watchlist", texto: "Watchlist" },
    { href: "/characters", texto: "Characters" },
    { href: "/reviews", texto: "Reviews" },
];
---

<header class="w-full sticky top-0 z-50 glass">
    <div class="max-w-6xl mx-auto px-4 flex items-center gap-6 py-4">
        <IconPage />

        <nav class="hidden md:flex items-center gap-1 ml-2">
            {
                enlaces.map((e) => (
                    <a
                        href={e.href}
                        class:list={[
                            "relative px-3 py-2 text-sm font-medium rounded-lg transition-all duration-300",
                            {
                                "text-accent bg-accent/8": path === e.href,
                            },
                            {
                                "text-text-secondary hover:text-text-primary hover:bg-white/4":
                                    path !== e.href,
                            },
                        ]}
                    >
                        {e.texto}
                    </a>
                ))
            }
        </nav>

        <div class="flex-1"></div>

        <ThemeToggle client:load />
        <SearchInput client:load />
    </div>
</header>
