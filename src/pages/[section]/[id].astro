---
import Layout from "@/layouts/Layout.astro";
import type { Anime } from "@/types/anime";
import { getAnimeById } from "@/service/getAnime";
import { getAnimeCharacters } from "@/service/getCharacters";
import CharactersList from "@/components/anime/characters";
import Details from "@/components/anime/details";
import WatchlistButton from "@/components/anime/watch-list";

const { section, id } = Astro.params;

if (!section || (section !== "anime" && section !== "manga"))
    return Astro.redirect("/");
const userId = Number(id);
if (!id || !userId) return Astro.redirect("/");

const [response, charactersResponse] = await Promise.all([
    getAnimeById(userId, section),
    getAnimeCharacters(userId, section),
]);

if (!response.data) return Astro.redirect("/");

const item = response.data as Anime;
const characters = charactersResponse.data ? charactersResponse.data : [];
const isAnime = section === "anime";
const imageUrl =
    item.images?.webp?.large_image_url ||
    item.images?.jpg?.large_image_url ||
    item.images?.jpg?.image_url;
const relateds = item.relations || [];
---

<Layout title={item.title || "Detail"}>
    <div class="pt-14 pb- animate-fade-in relative min-h-screen">
        <section
            class="fixed top-0 left-0 w-full h-full z-[-1] overflow-hidden opacity-10 pointer-events-none"
        >
            <img
                src={imageUrl}
                class="w-full h-full object-cover blur-[80px] scale-110"
                alt=""
                aria-hidden="true"
            />
            <div class="absolute inset-0 bg-bg/60"></div>
        </section>

        <section class="flex flex-col lg:flex-row gap-12">
            <article class="w-full lg:w-72 shrink-0 space-y-6">
                <div
                    class="rounded-2xl overflow-hidden shadow-2xl shadow-accent/10 animate-fade-up relative group"
                >
                    <img
                        src={imageUrl}
                        alt={item.title}
                        class="w-full aspect-3/4 object-cover transition-transform duration-700 group-hover:scale-105"
                    />
                </div>
                <WatchlistButton
                    anime={item}
                    section={section as "anime" | "manga"}
                    client:visible
                />
                <div
                    class="space-y-3 animate-fade-up"
                    style="animation-delay: 0.15s"
                >
                    <h3 class="section-title text-xl">Information</h3>
                    <ul class="text-sm space-y-3">
                        <li class="flex justify-between">
                            <span class="text-text-muted">Type</span>
                            <span class="text-text-primary font-medium"
                                >{item.type || "Unknown"}</span
                            >
                        </li>
                        {
                            isAnime ? (
                                <>
                                    <li class="flex justify-between">
                                        <span class="text-text-muted">
                                            Episodes
                                        </span>
                                        <span class="text-text-primary font-medium">
                                            {item.episodes || "Unknown"}
                                        </span>
                                    </li>
                                    <li class="flex justify-between">
                                        <span class="text-text-muted">
                                            Status
                                        </span>
                                        <span class="text-text-primary font-medium">
                                            {item.status || "Unknown"}
                                        </span>
                                    </li>
                                    <li class="flex justify-between">
                                        <span class="text-text-muted">
                                            Aired
                                        </span>
                                        <span class="text-text-primary font-medium text-right">
                                            {item.aired?.string || "Unknown"}
                                        </span>
                                    </li>
                                    {item.studios &&
                                        item.studios.length > 0 && (
                                            <li class="flex justify-between">
                                                <span class="text-text-muted">
                                                    Studios
                                                </span>
                                                <span class="text-text-primary font-medium text-right">
                                                    {item.studios
                                                        .map((s: any) => s.name)
                                                        .join(", ")}
                                                </span>
                                            </li>
                                        )}
                                </>
                            ) : (
                                <>
                                    <li class="flex justify-between">
                                        <span class="text-text-muted">
                                            Chapters
                                        </span>
                                        <span class="text-text-primary font-medium">
                                            {item.chapters || "Unknown"}
                                        </span>
                                    </li>
                                    <li class="flex justify-between">
                                        <span class="text-text-muted">
                                            Volumes
                                        </span>
                                        <span class="text-text-primary font-medium">
                                            {item.volumes || "Unknown"}
                                        </span>
                                    </li>
                                    <li class="flex justify-between">
                                        <span class="text-text-muted">
                                            Status
                                        </span>
                                        <span class="text-text-primary font-medium">
                                            {item.status || "Unknown"}
                                        </span>
                                    </li>
                                    <li class="flex justify-between">
                                        <span class="text-text-muted">
                                            Published
                                        </span>
                                        <span class="text-text-primary font-medium text-right">
                                            {item.published?.string ||
                                                "Unknown"}
                                        </span>
                                    </li>
                                    {item.authors &&
                                        item.authors.length > 0 && (
                                            <li class="flex justify-between">
                                                <span class="text-text-muted">
                                                    Authors
                                                </span>
                                                <span class="text-text-primary font-medium text-right">
                                                    {item.authors
                                                        .map((a: any) => a.name)
                                                        .join(", ")}
                                                </span>
                                            </li>
                                        )}
                                </>
                            )
                        }
                    </ul>
                </div>
                <Details optionsDetails={relateds} client:visible />
            </article>

            <article
                class="flex-1 space-y-8 animate-fade-up"
                style="animation-delay: 0.2s"
            >
                <header class="space-y-4">
                    <div class="flex flex-wrap gap-3">
                        {
                            item.genres?.map((g: any) => (
                                <span class="px-3 py-1 rounded-full text-xs font-semibold bg-accent/10 text-accent border border-accent/20">
                                    {g.name}
                                </span>
                            ))
                        }
                    </div>
                    <h1
                        class="text-3xl md:text-4xl lg:text-7xl font-black tracking-tight leading-tight text-text-primary"
                    >
                        {item.title}
                    </h1>
                    {
                        item.title_japanese && (
                            <h2 class="text-xl md:text-2xl lg:text-4xl text-text-muted font-medium">
                                {item.title_japanese}
                            </h2>
                        )
                    }
                </header>

                <section class="grid grid-cols-2 lg:grid-cols-4 gap-6">
                    <article class="text-center">
                        <span
                            class="text-text-muted text-[11px] font-bold uppercase tracking-widest block mb-1"
                            >Score</span
                        >
                        <div class="flex items-center justify-center gap-1.5">
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                class="text-amber-400 size-5"
                                viewBox="0 0 24 24"
                                fill="currentColor"
                            >
                                <path
                                    stroke="none"
                                    d="M0 0h24v24H0z"
                                    fill="none"></path>
                                <path
                                    d="M8.243 7.34l-6.38 .925l-.113 .023a1 1 0 0 0 -.44 1.684l4.622 4.499l-1.09 6.355l-.013 .11a1 1 0 0 0 1.464 .944l5.706 -3l5.693 3l.1 .046a1 1 0 0 0 1.352 -1.1l-1.091 -6.355l4.624 -4.5l.078 -.085a1 1 0 0 0 -.633 -1.62l-6.38 -.926l-2.852 -5.78a1 1 0 0 0 -1.794 0l-2.853 5.78z"
                                ></path>
                            </svg>
                            <span class="text-3xl font-black text-text-primary"
                                >{item.score || "N/A"}</span
                            >
                        </div>
                        {
                            item.scored_by && (
                                <span class="text-text-muted text-[10px]">
                                    {item.scored_by.toLocaleString()} users
                                </span>
                            )
                        }
                    </article>
                    <article class="text-center">
                        <span
                            class="text-text-muted text-[11px] font-bold uppercase tracking-widest block mb-1"
                            >Rank</span
                        >
                        <span class="text-3xl font-black text-text-primary"
                            >#{item.rank || "N/A"}</span
                        >
                    </article>
                    <article class="text-center">
                        <span
                            class="text-text-muted text-[11px] font-bold uppercase tracking-widest block mb-1"
                            >Popularity</span
                        >
                        <span class="text-3xl font-black text-text-primary"
                            >#{item.popularity || "N/A"}</span
                        >
                    </article>
                    <article class="text-center">
                        <span
                            class="text-text-muted text-[11px] font-bold uppercase tracking-widest block mb-1"
                            >Members</span
                        >
                        <span class="text-3xl font-black text-text-primary"
                            >{
                                item.members
                                    ? item.members > 1000000
                                        ? (item.members / 1000000).toFixed(1) +
                                          "M"
                                        : (item.members / 1000).toFixed(0) + "K"
                                    : "N/A"
                            }</span
                        >
                    </article>
                </section>

                {
                    item.synopsis && (
                        <p class="text-text-secondary leading-relaxed whitespace-pre-line text-base">
                            {item.synopsis}
                        </p>
                    )
                }

                {
                    item.background && (
                        <p class="text-text-secondary leading-relaxed whitespace-pre-line text-base">
                            {item.background}
                        </p>
                    )
                }

                {
                    isAnime && item.trailer?.youtube_id && (
                        <div class="aspect-video w-full rounded-2xl overflow-hidden">
                            <iframe
                                class="w-full h-full rounded-xl"
                                src={`https://www.youtube.com/embed/${item.trailer.youtube_id}`}
                                title={`${item.title} Trailer`}
                                frameborder="0"
                                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                                allowfullscreen
                            />
                        </div>
                    )
                }

                <CharactersList characters={characters} client:visible />
            </article>
        </section>
    </div>
</Layout>
