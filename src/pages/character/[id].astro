---
import Layout from "@/layouts/Layout.astro";
import {
    getCharacterFullById,
    getCharacterAnime,
    getCharacterManga,
} from "@/service/getCharacters";
import { formatNumber } from "@/const";
import AppearancesList from "@/components/character/appearances";

const { id } = Astro.params;

if (!id) return Astro.redirect("/characters");

const userId = Number(id);
if (!userId || isNaN(userId)) return Astro.redirect("/characters");

const [characterResponse, animeResponse, mangaResponse] = await Promise.all([
    getCharacterFullById(userId),
    getCharacterAnime(userId),
    getCharacterManga(userId),
]);

if (!characterResponse.data) {
    return Astro.redirect("/characters");
}

const character = characterResponse.data;
const animeRoles = animeResponse.data || [];
const mangaRoles = mangaResponse.data || [];
const imageUrl =
    character.images?.webp?.image_url || character.images?.jpg?.image_url || "";

interface ParsedInfo {
    [key: string]: string;
}

interface ParsedCategories {
    appearance: ParsedInfo;
    background: ParsedInfo;
    other: ParsedInfo;
}

function parseCharacterAbout(about: string | null): {
    categories: ParsedCategories;
    cleanAbout: string;
} {
    if (!about)
        return {
            categories: { appearance: {}, background: {}, other: {} },
            cleanAbout: "",
        };

    const appearance: ParsedInfo = {};
    const background: ParsedInfo = {};
    const other: ParsedInfo = {};
    const descriptionLines: string[] = [];

    const lines = about.split(/\n/);

    const appearanceKeys = [
        "height",
        "weight",
        "hair color",
        "eyecolor",
        "eye color",
        "bwh",
        "blood type",
        "bloodtype",
    ];
    const backgroundKeys = [
        "occupation",
        "affiliation",
        "class",
        "year",
        "grade",
        "origin",
        "residence",
        "species",
        "first appearance",
    ];

    for (const line of lines) {
        const trimmedLine = line.trim();

        if (!trimmedLine) continue;

        const colonIndex = trimmedLine.indexOf(":");

        if (colonIndex > 0) {
            const key = trimmedLine.slice(0, colonIndex).trim();
            const value = trimmedLine.slice(colonIndex + 1).trim();
            const keyLower = key.toLowerCase();

            const trimmedValue = value.trim();
            if (trimmedValue.length === 0) continue;

            const isProperCaseKey = key.match(/^[A-Z][a-z]+(\s+[A-Z][a-z]+)*$/);
            const isKnownKey =
                [...appearanceKeys, ...backgroundKeys].some((k) =>
                    keyLower.includes(k),
                ) ||
                [
                    "age",
                    "birthday",
                    "birthdate",
                    "gender",
                    "zodiac",
                    "horoscope",
                    "devil fruit",
                    "role",
                    "position",
                    "flaw",
                    "goal",
                ].some((k) => keyLower.includes(k));

            if (isKnownKey || isProperCaseKey) {
                const normalizedKey =
                    key.charAt(0).toUpperCase() + key.slice(1).toLowerCase();

                if (appearanceKeys.some((k) => keyLower.includes(k))) {
                    appearance[normalizedKey] = trimmedValue;
                } else if (backgroundKeys.some((k) => keyLower.includes(k))) {
                    background[normalizedKey] = trimmedValue;
                } else {
                    other[normalizedKey] = trimmedValue;
                }
                continue;
            }
        }

        descriptionLines.push(trimmedLine);
    }

    const cleanAbout = descriptionLines.join("\n").trim();

    return { categories: { appearance, background, other }, cleanAbout };
}

const { categories, cleanAbout } = parseCharacterAbout(character.about);
const { appearance, background, other } = categories;
---

<Layout title={`${character.name} - Character Details`}>
    <div class="pt-14 animate-fade-in relative">
        <div
            class="fixed top-0 left-0 w-full h-full z-[-1] overflow-hidden opacity-10 pointer-events-none"
        >
            <img
                src={imageUrl}
                class="w-full h-full object-cover blur-[80px] scale-110"
                alt=""
                aria-hidden="true"
            />
            <div class="absolute inset-0 bg-bg/60"></div>
        </div>

        <div class="flex flex-col lg:flex-row gap-12">
            <div class="w-full lg:w-72 shrink-0 space-y-6">
                <div
                    class="rounded-2xl overflow-hidden shadow-2xl shadow-accent/10 animate-fade-up relative group"
                >
                    {
                        imageUrl ? (
                            <img
                                src={imageUrl}
                                alt={character.name}
                                class="w-full aspect-3/4 object-cover transition-transform duration-700 group-hover:scale-105"
                            />
                        ) : (
                            <div class="w-full aspect-3/4 bg-text-muted animate-pulse" />
                        )
                    }
                </div>
                <div
                    class="space-y-3 animate-fade-up"
                    style="animation-delay: 0.15s"
                >
                    <h3 class="section-title text-xl">Information</h3>
                    <ul class="text-sm space-y-3">
                        {
                            character.age && (
                                <li class="flex justify-between">
                                    <span class="text-text-muted">Age</span>
                                    <span class="text-text-primary font-medium">
                                        {character.age}
                                    </span>
                                </li>
                            )
                        }
                        {
                            character.birthday && (
                                <li class="flex justify-between">
                                    <span class="text-text-muted">
                                        Birthday
                                    </span>
                                    <span class="text-text-primary font-medium">
                                        {character.birthday}
                                    </span>
                                </li>
                            )
                        }
                        <li class="flex justify-between">
                            <span class="text-text-muted">Favorites</span>
                            <span class="text-text-primary font-medium">
                                {formatNumber(character.favorites)}
                            </span>
                        </li>
                        {
                            character.nicknames &&
                                character.nicknames.length > 0 && (
                                    <li class="flex flex-col gap-2">
                                        <span class="text-text-muted text-xs uppercase tracking-wider">
                                            Nicknames
                                        </span>
                                        <div class="flex flex-wrap gap-1">
                                            {character.nicknames.map(
                                                (nickname) => (
                                                    <span class="px-2 py-0.5 bg-surface-elevated rounded text-xs text-text-secondary">
                                                        {nickname}
                                                    </span>
                                                ),
                                            )}
                                        </div>
                                    </li>
                                )
                        }
                    </ul>
                </div>

                {
                    Object.keys(appearance).length > 0 && (
                        <ul
                            class="text-sm space-y-3 animate-fade-up"
                            style="animation-delay: 0.12s"
                        >
                            {Object.entries(appearance).map(([key, value]) => (
                                <li class="flex justify-between">
                                    <span class="text-text-muted">{key}</span>
                                    <span class="text-text-primary font-medium text-right">
                                        {value}
                                    </span>
                                </li>
                            ))}
                        </ul>
                    )
                }

                {
                    Object.keys(background).length > 0 && (
                        <ul
                            class="text-sm space-y-3 animate-fade-up"
                            style="animation-delay: 0.13s"
                        >
                            {Object.entries(background).map(([key, value]) => (
                                <li class="flex justify-between">
                                    <span class="text-text-muted">{key}</span>
                                    <span class="text-text-primary font-medium text-right">
                                        {value}
                                    </span>
                                </li>
                            ))}
                        </ul>
                    )
                }

                {
                    Object.keys(other).length > 0 && (
                        <ul
                            class="text-sm space-y-3 animate-fade-up"
                            style="animation-delay: 0.14s"
                        >
                            {Object.entries(other).map(([key, value]) => (
                                <li class="flex justify-between">
                                    <span class="text-text-muted">{key}</span>
                                    <span class="text-text-primary font-medium text-right">
                                        {value}
                                    </span>
                                </li>
                            ))}
                        </ul>
                    )
                }
            </div>

            <div
                class="flex-1 space-y-8 animate-fade-up"
                style="animation-delay: 0.2s"
            >
                <header class="space-y-4">
                    <h1
                        class="text-3xl md:text-4xl lg:text-7xl font-black tracking-tight leading-tight text-text-primary"
                    >
                        {character.name}
                    </h1>
                    {
                        character.name_kanji && (
                            <h2 class="text-xl md:text-2xl lg:text-4xl text-text-muted font-medium">
                                {character.name_kanji}
                            </h2>
                        )
                    }
                </header>

                {
                    (cleanAbout ||
                        (character.about &&
                            Object.keys(appearance).length === 0 &&
                            Object.keys(background).length === 0 &&
                            Object.keys(other).length === 0)) && (
                        <p class="text-text-secondary leading-relaxed whitespace-pre-line text-base">
                            {cleanAbout || character.about}
                        </p>
                    )
                }

                <AppearancesList
                    animeRoles={animeRoles}
                    mangaRoles={mangaRoles}
                    client:visible
                />
            </div>
        </div>
    </div>
</Layout>
